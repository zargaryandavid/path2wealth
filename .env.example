# Copy to .env.local and fill in real values.
# Use the project's URL and the publishable/anon key (sb_publishable_... or the JWT anon key).
# Never put sb_secret_ / service_role on an EXPO_PUBLIC_* line — Expo inlines those into the app.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Local scripts only (scripts/create-auth-user.js). Dashboard → Settings → API → service_role.
# SUPABASE_SERVICE_ROLE_KEY=
